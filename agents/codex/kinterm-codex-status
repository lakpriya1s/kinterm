#!/bin/sh
# Codex hook that reports the session's status to KinTerm using OSC 7501
# (the Program Status Protocol). KinTerm shows it as a face on the tab and
# sends a notification when Codex finishes or needs you.
#
# Codex runs this for each hook event with the event as JSON on stdin. See
# README.md for the events it's registered for.

# Only talk to terminals that understand OSC 7501. KinTerm still sets
# TERM_PROGRAM=ghostty, so programs that check for Ghostty's features keep
# working in it.
[ "$TERM_PROGRAM" = "ghostty" ] || exit 0

input=$(cat)

# Read a top-level string field from the hook's JSON input.
field() {
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$input" | jq -r --arg k "$1" '.[$k] // empty | if type == "string" then . else empty end' 2>/dev/null
  else
    printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
  fi
}

# Read a string field from the tool's input, e.g. the command being run.
tool_field() {
  command -v jq >/dev/null 2>&1 || return 0
  printf '%s' "$input" | jq -r --arg k "$1" '.tool_input[$k] // empty | if type == "string" then . elif type == "array" then join(" ") else empty end' 2>/dev/null
}

# Encode text for a title, msg or last value: one line, at most 180
# bytes, valid UTF-8 (iconv drops a character cut in half), then base64.
encode() {
  printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037' | tr -s ' ' | head -c 180 |
    iconv -c -f UTF-8 -t UTF-8 2>/dev/null | base64 | tr -d '\n'
}

# What a tool call is about, for the hover card.
tool_detail() {
  detail=$(tool_field description)
  [ -n "$detail" ] || detail=$(tool_field command)
  [ -n "$detail" ] || detail=$(tool_field cmd)
  [ -n "$detail" ] || detail=$(tool_field file_path)
  [ -n "$detail" ] || detail=$(tool_field path)
  printf '%s' "$detail"
}

event=$(field hook_event_name)
cwd=$(field cwd)
kind=""
msg=""
last=""

case "$event" in
  SessionStart)
    state=idle
    msg="Ready"
    ;;
  UserPromptSubmit)
    state=working
    msg=$(field prompt)
    ;;
  PreToolUse)
    state=working
    tool=$(field tool_name)
    case "$tool" in
      apply_patch | Edit | Write) detail="editing files" ;;
      *) detail=$(tool_detail) ;;
    esac
    if [ -n "$detail" ]; then msg="$tool: $detail"; else msg="$tool"; fi
    ;;
  PostToolUse)
    state=working
    msg="Thinking"
    ;;
  PermissionRequest)
    # Codex is asking to run something: it waits for you.
    state=blocked
    kind=permission
    tool=$(field tool_name)
    detail=$(tool_detail)
    if [ -n "$detail" ]; then msg="Allow $tool: $detail?"; else msg="Allow $tool?"; fi
    ;;
  PostModelRequest)
    # Only a failed request is news: rate limited, overloaded, auth...
    error=$(field error)
    [ -n "$error" ] || exit 0
    state=error
    msg="Error: $error"
    ;;
  Stop)
    state=done
    msg="Finished"
    last=$(field last_assistant_message)
    ;;
  Interrupt)
    # You stopped the turn; it waits for you, nothing new to see.
    state=idle
    msg="Interrupted"
    ;;
  SessionEnd)
    state=clear
    ;;
  *)
    exit 0
    ;;
esac

# Which Codex account this is: the CODEX_HOME folder's name, e.g.
# ".codex-work". KinTerm colors the ring around the face by account.
account=$(basename "${CODEX_HOME:-$HOME/.codex}" | tr -cd 'A-Za-z0-9_.+-' | cut -c1-32)

report="state=$state:app=codex"
[ -n "$account" ] && report="$report:account=$account"
[ -n "$kind" ] && report="$report:kind=$kind"
[ -n "$cwd" ] && report="$report:title=$(encode "$(basename "$cwd")")"
[ -n "$msg" ] && report="$report:msg=$(encode "$msg")"
[ -n "$last" ] && report="$report:last=$(encode "$last")"

# The terminal to write to. Hooks don't get the terminal as stdout and may
# have no controlling terminal; then use the terminal of the nearest
# parent process that has one: Codex itself.
status_tty() {
  if [ -n "${GHOSTTY_STATUS_TTY:-}" ]; then
    echo "$GHOSTTY_STATUS_TTY"
    return
  fi
  if (: >/dev/tty) 2>/dev/null; then
    echo /dev/tty
    return
  fi
  pid=$PPID
  i=0
  while [ "${pid:-0}" -gt 1 ] && [ "$i" -lt 8 ]; do
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case "$t" in
      "" | "?" | "??") ;;
      *)
        [ -w "/dev/$t" ] && echo "/dev/$t"
        return
        ;;
    esac
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
}

tty=$(status_tty)
[ -n "$tty" ] || exit 0

# Never fail the hook because of this, and never print anything: Codex
# would add plain output to the conversation for some events.
printf '\033]7501;%s\033\\' "$report" 2>/dev/null >"$tty" || true
exit 0
